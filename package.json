{
  "name": "dsh-profile-researcher",
  "version": "0.1.0",
  "private": true,
  "description": "Project-scoped, cross-session research targets for DeepSeek Harness research mode",
  "type": "module",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./command": {
      "types": "./lib/command.d.ts",
      "default": "./lib/command.js"
    },
    "./tool": {
      "types": "./lib/tool.d.ts",
      "default": "./lib/tool.js"
    },
    "./invariant": {
      "types": "./lib/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./client": {
      "types": "./lib/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./client-types": {
      "types": "./lib/types.d.ts",
      "default": "./lib/types.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md"
  ],
  "dsh": {
    "engines": {
      "dsh": "^0.1.2-alpha.3"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-commands"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "build": "pnpm run clean && tsc -p tsconfig.json && tsdown",
    "check": "pnpm run typecheck && pnpm run test && pnpm run build"
  },
  "dependencies": {
    "zod": "^4.5.4"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-agent": "^0.1.2-alpha.3",
    "@deepseek-ai/dsh-agent-loop": "^0.1.2-alpha.3",
    "@deepseek-ai/dsh-api-remotes": "^0.1.2-alpha.3",
    "@deepseek-ai/dsh-api-session-controller": "^0.1.2-alpha.3",
    "@deepseek-ai/dsh-client-ui-commands": "^0.1.2-alpha.3",
    "@deepseek-ai/dsh-commands": "^0.1.2-alpha.3",
    "@deepseek-ai/dsh-fs": "^0.1.2-alpha.3",
    "@deepseek-ai/dsh-goal": "^0.1.2-alpha.3",
    "@deepseek-ai/dsh-invariants": "^0.1.2-alpha.3",
    "@deepseek-ai/dsh-llm": "^0.1.2-alpha.3",
    "@deepseek-ai/dsh-sandbox": "^0.1.2-alpha.3",
    "@deepseek-ai/dsh-sandbox-policy": "^0.1.2-alpha.3",
    "@deepseek-ai/dsh-session": "^0.1.2-alpha.3",
    "@deepseek-ai/dsh-session-projection": "^0.1.2-alpha.3",
    "@deepseek-ai/dsh-tools": "^0.1.2-alpha.3",
    "@deepseek-ai/dsh-typert-protocol": "^0.1.2-alpha.3",
    "@deepseek-ai/dsh-typert-registry": "^0.1.2-alpha.3",
    "@deepseek-ai/dsh-util-values": "^0.1.2-alpha.3"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-agent": "^0.1.2-alpha.3",
    "@deepseek-ai/dsh-agent-loop": "^0.1.2-alpha.3",
    "@deepseek-ai/dsh-api-remotes": "^0.1.2-alpha.3",
    "@deepseek-ai/dsh-api-session-controller": "^0.1.2-alpha.3",
    "@deepseek-ai/dsh-client-ui-commands": "^0.1.2-alpha.3",
    "@deepseek-ai/dsh-commands": "^0.1.2-alpha.3",
    "@deepseek-ai/dsh-fs": "^0.1.2-alpha.3",
    "@deepseek-ai/dsh-fs-local": "^0.1.2-alpha.3",
    "@deepseek-ai/dsh-goal": "^0.1.2-alpha.3",
    "@deepseek-ai/dsh-invariants": "^0.1.2-alpha.3",
    "@deepseek-ai/dsh-llm": "^0.1.2-alpha.3",
    "@deepseek-ai/dsh-sandbox": "^0.1.2-alpha.3",
    "@deepseek-ai/dsh-sandbox-policy": "^0.1.2-alpha.3",
    "@deepseek-ai/dsh-session": "^0.1.2-alpha.3",
    "@deepseek-ai/dsh-session-projection": "^0.1.2-alpha.3",
    "@deepseek-ai/dsh-tools": "^0.1.2-alpha.3",
    "@deepseek-ai/dsh-typert-protocol": "^0.1.2-alpha.3",
    "@deepseek-ai/dsh-typert-registry": "^0.1.2-alpha.3",
    "@deepseek-ai/dsh-util-values": "^0.1.2-alpha.3",
    "@types/node": "^22.20.0",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
